{
  "name": "boilerplate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "gen:types": "node scripts/generate-product-types.mjs",
    "type-check": "tsc --noEmit -p tsconfig.json --pretty false",
    "lint": "eslint . --fix --quiet --no-color",
    "build": "NO_COLOR=1 NODE_ENV=production vite build --configLoader runner",
    "test": "vitest run --passWithNoTests --configLoader runner",
    "bundle:action": "node scripts/bundle-code-action.mjs",
    "test:action": " NO_COLOR=1 node scripts/test-code-action.mjs",
    "knip": "knip",
    "dev": "VITE_BUILD_STANDALONE=1 vite --configLoader runner",
    "preview": "VITE_BUILD_STANDALONE=1 vite build --configLoader runner && vite preview --configLoader runner",
    "build:framework": "NO_COLOR=1 NODE_ENV=production react-router build --config vite.framework.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@blocksdiy/blocks-client-sdk": "latest",
    "@blocksdiy/react-common": "latest",
    "@fontsource-variable/inter": "5.3.0",
    "class-variance-authority": "0.7.1",
    "date-fns": "4.4.0",
    "isbot": "5.2.2",
    "leaflet": "1.9.4",
    "leaflet-geosearch": "4.2.2",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "lucide-react": "1.72.0",
    "motion": "14.14.0",
    "papaparse": "5.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "react-router": "8.5.1",
    "resize-observer-polyfill": "1.5.1",
    "shadcn": "4.23.0",
    "cn": "0.5.2",
    "tw-animate-css": "1.4.0",
    "whatwg-fetch": "3.6.20",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7",
    "streamdown": "2.6.0"
  },
  "devDependencies": {
    "@blocksdiy/eslint-plugin-auto-import": "latest",
    "@eslint/js": "9.39.2",
    "@react-router/dev": "8.5.1",
    "@react-router/node": "8.5.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.3",
    "@types/lodash": "4.17.27",
    "@types/leaflet": "1.9.21",
    "@types/node": "24.9.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "15.15.0",
    "jsdom": "26.1.0",
    "knip": "5.68.0",
    "npm-run-all": "4.1.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vite": "8.3.8",
    "vite-plugin-component-debugger": "2.3.2",
    "vitest": "4.1.11"
  }
}